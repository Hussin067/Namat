# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Placeholders only: nothing in this file is a real credential.

# development | production   (production turns off /docs and hides tracebacks in logs)
APP_ENV=development

# PostgreSQL (psycopg 3 driver). Tests use the same local server with the database
# name changed to namat_test; a non-local server needs TEST_DATABASE_URL (ending in _test).
DATABASE_URL=postgresql+psycopg://namat_app:CHANGE_ME@localhost:5432/namat_dev

# Optional: a direct (non-pooled) connection used only by Alembic migrations.
# Leave it unset locally; migrations then use DATABASE_URL. In production on Neon,
# DATABASE_URL is the pooled "-pooler" URL (for the app) and this is the direct URL.
# DIRECT_DATABASE_URL=postgresql+psycopg://USER:CHANGE_ME@DIRECT-HOST/DBNAME?sslmode=require

# At least 32 random characters, different from the database password. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start while this still contains CHANGE_ME.
JWT_SECRET_KEY=CHANGE_ME

# Minutes an access token stays valid (5–60).
ACCESS_TOKEN_EXPIRE_MINUTES=20

# Browser origin(s) allowed to call the API (CORS), comma-separated, no trailing slash.
FRONTEND_URL=http://localhost:5173
