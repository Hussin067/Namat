# Copy this file to .env and fill in real values locally.
# Never commit .env — it is excluded by .gitignore.

# Environment name: development or production
APP_ENV=development

# PostgreSQL connection string (SQLAlchemy + psycopg 3 driver; Neon in production)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# If the password contains special characters (@ : / # % ?), URL-encode them.
DATABASE_URL=postgresql+psycopg://namat_app:CHANGE_ME@localhost:5432/namat_dev

# Frontend origin allowed to call the API (CORS)
FRONTEND_URL=http://localhost:5173
